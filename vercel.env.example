# Environment variables for Vercel (see docs/deploy-vercel.md).
#
#   npm run setup:vercel-env    → writes .env.vercel with fresh secrets (never commit it)
#
# Then in Vercel: Project → Settings → Environment Variables → "Import .env"
# (or paste the file's content), environment "Production" (and "Preview" if used).
#
# Added automatically by the Vercel integrations — do NOT set them here:
#   DATABASE_URL, DATABASE_URL_UNPOOLED   Neon Postgres (region Frankfurt, aws-eu-central-1)
#   BLOB_READ_WRITE_TOKEN                 Vercel Blob store (access: private)

# Final public address. QR codes on issued certificates keep this URL forever.
# Without APP_URL the <project>.vercel.app domain is used — fine for testing only.
# APP_URL=https://halal-zertifizierung.de

# Key for hashing visitor IP addresses (rate limits, logs) — raw IPs are never stored.
IP_HASH_SECRET=<generate:hex:32>
# AES-256-GCM key for two-factor secrets (64 hex chars). Keep it stable: changing it
# invalidates every enrolled authenticator app.
TOTP_ENCRYPTION_KEY=<generate:hex:32>

# Private file storage: Vercel Blob (default on Vercel, stated here for clarity).
STORAGE_DRIVER=vercel-blob
# Connections per function instance (Neon's pooled URL handles the rest).
DATABASE_POOL_MAX=5

# First super admin, created by the build when both values are set.
# Replace the e-mail with your own before importing. After the first login: change the
# password, enable 2FA, then delete SEED_SUPERADMIN_PASSWORD in Vercel.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PASSWORD=<generate:password:20>

# Contact form: recipient of messages from the website.
CONTACT_TO_EMAIL=info@halal-zertifizierung.com
# Optional SMTP for sending contact messages by e-mail (without it they are only stored
# in the admin panel). Remove the leading "# " and fill in to enable.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=WHU Website <noreply@halal-zertifizierung.de>
