# Copy to .env — or run `npm run setup:env`, which fills every <generate…> value
# with a random secret. Never commit .env.

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL; QR codes point to ${APP_URL}/v/{token}. Production: https://halal-zertifizierung.org
APP_URL=http://localhost:3000

# ── HTTPS reverse proxy (Caddy, docker-compose `caddy`) ─────────────────────
# Domain Caddy requests a Let's Encrypt certificate for (DNS A/AAAA record must point here).
DOMAIN=localhost
# Optional second name redirected to DOMAIN, e.g. www.halal-zertifizierung.org
REDIRECT_DOMAIN=www.localhost
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Key for hashing visitor IP addresses (rate limits, logs) — raw IPs are never stored.
IP_HASH_SECRET=<generate:hex:32>
# AES-256-GCM key for two-factor secrets at rest (64 hex chars). Keep it stable:
# changing it invalidates every enrolled authenticator.
TOTP_ENCRYPTION_KEY=<generate:hex:32>

# 2FA is required for Super Admin/Admin unless this is "false" (password-only sign-in).
# REQUIRE_2FA=true

# ── Contact form e-mail (SMTP) ──────────────────────────────────────────────
# Leave SMTP_HOST empty to only store messages in the database (admin panel).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="WHU Website <noreply@halal-zertifizierung.org>"
CONTACT_TO_EMAIL=info@halal-zertifizierung.org

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=whu
POSTGRES_USER=whu
POSTGRES_PASSWORD=<generate:hex:24>
# Used by Next.js, the Prisma CLI and the seed when running on the host.
# (docker compose overrides it to point at the `postgres` service.)
DATABASE_URL=postgresql://whu:<POSTGRES_PASSWORD>@localhost:5432/whu
# Optional: connection pool size per app process (default 10).
# DATABASE_POOL_MAX=10

# ── Object storage: Garage (S3-compatible) ──────────────────────────────────
# s3 = Garage (docker-compose `storage` service); fs = local folder STORAGE_DIR (dev without Docker).
STORAGE_DRIVER=s3
STORAGE_DIR=.data/storage
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=whu-files
S3_ACCESS_KEY_ID=<generate:garage-key-id>
S3_SECRET_ACCESS_KEY=<generate:hex:32>
GARAGE_RPC_SECRET=<generate:hex:32>
GARAGE_ADMIN_TOKEN=<generate:hex:32>

# ── Backups (docker-compose `backup`) ───────────────────────────────────────
# Host folder for daily dumps and storage copies — copy it off the server too!
BACKUP_DIR=./backups
BACKUP_TIME=02:30
BACKUP_TZ=Europe/Berlin
BACKUP_KEEP_DAYS=30
# Optional off-site target as an rclone remote, e.g. "offsite:whu-backups", configured
# with RCLONE_CONFIG_OFFSITE_* variables (see docs/deploy.md).
BACKUP_RCLONE_REMOTE=

# ── Seed ────────────────────────────────────────────────────────────────────
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_NAME=Super Admin
# Leave empty to generate a password; it is printed once by the seed.
SEED_SUPERADMIN_PASSWORD=
# Demo company + 3 test certificates (active, expired, revoked). false in production.
SEED_DEMO=true
