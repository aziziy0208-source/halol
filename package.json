{
  "name": "whu-halal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:vercel-env": "node scripts/setup-env.mjs vercel.env.example .env.vercel",
    "services:up": "docker compose up -d postgres storage",
    "services:down": "docker compose down",
    "admin": "tsx scripts/admin.ts",
    "test:e2e": "bash tests/e2e/run.sh",
    "local": "bash scripts/local.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sparticuz/chromium-min": "153.0.0",
    "@vercel/blob": "2.9.0",
    "altcha": "3.5.0",
    "altcha-lib": "2.8.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "playwright-core": "1.65.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.14",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
